---
import "../styles/global.css";
import type { DistrictT } from '../schema/records';
import { href } from '../lib/url';
interface Props { title: string; description?: string; district?: DistrictT }
const { title, description = "Where a school facility need stands, who decides next, and where to engage.", district } = Astro.props;
const pageTitle = `${title} · FundED`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(href('/og.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FundED" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FundED: where a school facility need stands, who decides next, and where to engage." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Opt in to the one-shot reveal animations before first paint, so nothing flashes.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line print:hidden">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={href('/')} class="font-serif text-xl font-semibold">FundED</a>
        <div class="flex gap-5 text-sm text-ink-muted">
          {district && <a href={href(`/${district.id}/`)} class="hidden sm:inline">{district.short_name ?? district.name}</a>}
          {district && <a href={href(`/${district.id}/tracks/`)}>How it works</a>}
          <a href={href('/roadmap/')}>Roadmap</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl px-4 py-10 text-sm text-ink-muted print:hidden">
      FundED · Arlington Public Schools pilot · An EMBA Ethics Project, Georgetown McDonough, Fall 2026.
    </footer>
    <script is:inline>
      // Play each [data-reveal] group once when it scrolls into view; count [data-countup] numbers up to their printed value.
      (() => {
        if (!document.documentElement.classList.contains('motion')) return;
        const countUp = el => {
          const to = +el.dataset.countup, t0 = performance.now(), ms = 900;
          const step = t => { const k = Math.min(1, (t - t0) / ms); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
          el.textContent = '0'; requestAnimationFrame(step);
        };
        const io = new IntersectionObserver(entries => entries.forEach(e => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target); e.target.classList.add('in');
          e.target.querySelectorAll('[data-countup]').forEach(countUp);
        }), { threshold: 0.2 });
        document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
