---
import type { TrackT } from '../schema/records';
import BasisChip from './BasisChip.astro';
import EngageList from './EngageList.astro';
import Inquiries from './Inquiries.astro';
import { verificationLabel } from '../lib/labels';
interface Props { track: TrackT; today: string }
const { track, today } = Astro.props;
---
<section id={track.id} class="rounded-lg border border-line bg-white p-5">
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-2xl">{track.name}</h2>
    <span class:list={['rounded px-2 py-0.5 text-[0.7rem] font-bold uppercase tracking-wide', track.verification === 'confirmed' ? 'bg-done text-white' : 'bg-draft-soft text-draft']}>{verificationLabel[track.verification]}</span>
  </header>
  <p class="mt-2 text-ink-muted">{track.description}</p>
  <dl class="mt-3 text-sm">
    <dt class="font-semibold">When a need goes on this track</dt><dd>{track.routing_rule}</dd>
    {track.policy_citation && <><dt class="mt-2 font-semibold">Policy</dt><dd>{track.policy_citation}</dd></>}
    {track.verified_by && <><dt class="mt-2 font-semibold">Verified by</dt><dd>{track.verified_by}{track.verified_on ? `, ${track.verified_on}` : ''}</dd></>}
  </dl>
  <ol class="mt-4 space-y-2">
    {track.stages.map(s => (
      <li class="flex gap-3">
        <span class="mt-1 h-6 w-6 shrink-0 rounded-full bg-accent-soft text-center text-sm font-semibold text-accent">{s.order}</span>
        <div>
          <p class="font-semibold">{s.name} <BasisChip basis={s.basis} sourceId={s.source_id} sources={track.sources} uid={`src-${track.id}-${s.id}`} /></p>
          <p class="text-sm text-ink-muted">Decides: {s.decider}{s.venue ? ` · ${s.venue}` : ''}{s.typical_duration ? ` · typically ${s.typical_duration}` : ''}</p>
        </div>
      </li>
    ))}
  </ol>
  {track.engage.length > 0 && (
    <section class="mt-6" aria-labelledby={`${track.id}-raise`} data-testid="track-raise">
      <h3 id={`${track.id}-raise`} class="text-lg">How to raise a need on this track</h3>
      <p class="mb-3 text-sm text-ink-muted">Soonest first. Each venue carries a question you can put to it as written.</p>
      <EngageList rows={track.engage} sources={track.sources} today={today} uid={track.id} dense />
    </section>
  )}
  {track.inquiries.length > 0 && (
    <section class="mt-6" aria-labelledby={`${track.id}-asked`} data-testid="track-asked">
      <h3 id={`${track.id}-asked`} class="text-lg">What has been asked about this track</h3>
      <div class="mt-3"><Inquiries inquiries={track.inquiries} sources={track.sources} /></div>
    </section>
  )}
</section>
