---
import type { DistrictT, TrackT } from '../schema/records';
import { draftState } from '../lib/draft';
import { href } from '../lib/url';
interface Props { tracks: TrackT[]; district: DistrictT }
const { district } = Astro.props;
const { isDraft, unconfirmed } = draftState(Astro.props.tracks);
---
{isDraft && (
  <aside class="mb-8 flex flex-wrap items-center gap-4 rounded-lg border-2 border-draft bg-draft-soft p-4" role="note">
    <span class="stamp">Draft</span>
    <p class="max-w-prose text-sm">
      Who-decides information is our best current reading of {district.short_name ?? district.name} policy and has not yet been confirmed by a {district.short_name ?? district.name} contact
      for {unconfirmed.length} of {Astro.props.tracks.length} tracks. We are confirming it as part of this project.{' '}
      <a href={href(`/${district.id}/tracks/`)} class="underline">See what is verified.</a>
    </p>
  </aside>
)}
