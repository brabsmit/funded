---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DraftBanner from '../../components/DraftBanner.astro';
import TrackLane from '../../components/TrackLane.astro';
import { today } from '../../lib/dates';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const districts = await getCollection('districts');
  return districts.map(d => ({ params: { district: d.data.id }, props: { district: d.data } }));
}
const { district } = Astro.props;
const order = ['cip', 'mcmm', 'gift'];
const asOf = today();
const tracks = (await getCollection('tracks')).map(t => t.data).filter(t => t.district_id === district.id)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---
<Base title={`How it works in ${district.short_name ?? district.name}`} district={district}>
  <p class="text-sm text-ink-muted">{district.name}</p>
  <h1 class="text-4xl">How a school facility need gets decided in {district.name}</h1>
  <p class="mt-3 max-w-prose text-lg text-ink-muted">{tracks.length} tracks, {tracks.length} different owners. A need lands on one of them based on what it is and what it costs. These are {district.short_name ?? district.name}'s own processes; every school in the district runs on the same ones.</p>
  <div class="mt-6"><DraftBanner tracks={tracks} district={district} /></div>
  <div class="grid gap-5 lg:grid-cols-3">
    {tracks.map(t => <TrackLane track={t} today={asOf} />)}
  </div>
  <p class="mt-4 text-sm text-ink-muted">Countdowns computed as of {asOf}. Reviewing these for {district.short_name ?? district.name}? <a href={href(`/${district.id}/confirm/`)} class="underline">Print the confirmation sheet</a>.</p>
</Base>
