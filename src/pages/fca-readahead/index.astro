---
// Unlisted team agenda for the first FCA meeting. Not linked from the nav; noindex.
// Replaced the angle-E PRD (and its workstream sub-PRDs) on Oct 15, 2026: those were a proposal, not a team decision.
// Figures carry the research report's reliability flags: [VENDOR] = sells into K-12. Do not promote a flagged figure into a load-bearing claim.
import Base from '../../layouts/Base.astro';

const meta = [
  ['Status', 'Open. Nothing below is decided until the team decides it.'],
  ['Length', '~60 minutes'],
  ['Paper due', 'Mon Nov 2, 12:00 noon'],
];

const decisions = [
  {
    n: '1',
    title: 'Scope',
    mins: '10 min',
    q: 'Is FundED about “complex community systems” (our draft mission) or school facility needs only?',
    evidence: [
      'Secondary research found defensible white space in only two places: who decides the next gate on a school capital project, and building-level matching of utility, state and federal incentives.',
      'The broad version collides with ClearGov (transparency platform, May 2026) and towntoonify ($10/mo, launched Oct 10–12, already inviting school districts).',
    ],
    sets: 'Persona, TAM and the competitive matrix.',
  },
  {
    n: '2',
    title: 'Hearts + Minds story',
    mins: '5 min',
    q: 'General (“real needs get stuck”) or the Oakridge HVAC version (ALT)?',
    evidence: [
      'CCPTA’s Apr 2026 letter: “school communities are under the impression that renovations… are happening soon.” That is the Oakridge pain.',
      'The ALT names three users (districts, principals, parents). DE Step 5 needs one persona.',
    ],
    sets: 'Component 1 and who the persona is.',
  },
  {
    n: '3',
    title: 'Who pays',
    mins: '15 min',
    q: 'Which payer do we analyze?',
    evidence: [
      'APS: the natural buyer, but also the party CCPTA is criticizing. Under ~$10K may avoid an RFP (sources conflict on the threshold).',
      'PTAs: software runs ~$100–$300/yr. [VENDOR]',
      'Arlington County or a foundation: no evidence yet that either would fund it.',
      'Low-capacity Virginia divisions: have the capacity problem Arlington lacks, but we have no data on them yet.',
      'Pre-performance-contract incentive stacking: the ESCO already pitching APS (CMTA, Feb 2026) offers to run the federal tax-credit filing itself, so the incentive-navigation job is bundled into the contract. FOIA 26-16.',
    ],
    sets: 'Value proposition, business model and the stance in component 5.',
  },
  {
    n: '4',
    title: 'Component 5 stance',
    mins: '10 min',
    q: 'Do we argue “yes, equipped,” “no, not equipped,” or “yes, if…”?',
    evidence: [
      'The spec asks for a definitive stance on whether the founding team is equipped to sustain its competitive advantage.',
      'A well-argued “no” is legitimate, but it is a claim about us. Everyone should be comfortable signing it.',
    ],
    sets: 'Whether we need kill thresholds, and what primary research has to prove.',
  },
];

const threats = [
  ['T1', 'Explorer is commoditized', 'towntoonify (launched Oct 10–12, $10/mo) already invites school districts; ClearGov launched a transparency platform May 2026.'],
  ['T2', 'Arlington is a weak test of “capacity”', 'APS is wealthy, but FOIA 26-16 shows no competitive facility grants, no utility rebates and no IRA elective-pay filings since July 2023; its one award was a $5.3M formula grant. No study measures K-12 energy-grant capture by district capacity.'],
  ['T3', 'Federal non-bond pool is shrinking', 'ESSER closed; 179D, 45W, 30C ended; Renew America’s Schools frozen.'],
  ['T4', 'PTAs pay ~$100–$300/yr', 'Free substitutes exist. [VENDOR]'],
  ['T5', 'The natural buyer is the party being criticized', 'A tool PTAs see as theirs may look like an advocacy weapon to APS.'],
  ['T6', 'ESCOs already capture incentives', '≥ two-thirds of Renew America’s Schools Round 1 grantees had performance-contracting partners. At APS, CMTA’s April 2026 scope prices Oakridge at $27.5M and Jamestown at $31.0M with $11.8M of federal tax credit it would file for, and targets a signed contract on Dec 11, 2026 (FOIA 26-16).'],
  ['T7', 'Small software TAM, tuck-in endgame', 'Illustrative district TAM ~$70–200M/yr (assumption-driven).'],
];

const split = [
  'Component 2 (mindset): each of us brings our own observable dispositions and skills. Only we can supply these.',
  'Interview targets for Oct 19–28: APS staff; CCPTA and PTA leaders; Arlington County and the Civic Federation; comparable districts and ESCOs.',
  'Decide whether the paper treats the Nov 3 bond referendum as pending or leaves it out. The paper is due Nov 2, so we can’t cite the outcome.',
];

const fyi = [
  'FOIA 26-16 (sent Oct 14, asking about non-bond and incentive funding) was answered and closed on Oct 20, in six days, at no charge, with no exemptions. No utility rebates, no IRA elective-pay filings, one formula grant ($5.3M ARPA, Barcroft HVAC). The Board’s “non-bond financing analysis” is two CMTA decks: a Feb 2026 ESPC pitch and an Apr 2026 scope for Oakridge and Jamestown. No solicitation, letter of intent or contract was produced. Seven files and a digest are in the team Drive folder under “FOIA 26-16”; the Oakridge and Jamestown pages now carry the figures.',
  'Earlier versions of this page showed a full PRD for one angle (“E”). That was a proposal from prep work, not a team decision. It has been taken down.',
];
---
<Base title="FCA Team Meeting Agenda" description="Agenda for the FundED FCA team's first meeting: four decisions, in order." noindex>
  <aside class="mb-8 rounded-lg border-2 border-draft bg-draft-soft p-4 text-sm" role="note">
    <span class="stamp">Internal</span>
    <p class="mt-3 max-w-prose">
      Team document for our New Business Ventures Final Case Analysis. Not part of the FundED tool.
      Unlisted, but anyone with the link can read it: don’t forward it outside the team.
    </p>
  </aside>

  <p class="text-[0.7rem] uppercase tracking-wide text-ink-muted">First team meeting</p>
  <h1 class="mt-1 text-4xl">FundED FCA: four decisions, in order</h1>
  <dl class="mt-5 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[9rem_1fr]">
    {meta.map(([k, v]) => (<><dt class="text-ink-muted">{k}</dt><dd>{v}</dd></>))}
  </dl>

  <section class="mt-10 rounded-lg border-2 border-accent bg-accent-soft p-5">
    <h2 class="text-2xl">Goal</h2>
    <p class="mt-2 max-w-prose">Leave with four decisions: scope, story, payer and stance. Each one depends on the one before it, so we take them in order.</p>
  </section>

  {decisions.map(d => (
    <section class="mt-12">
      <div class="flex flex-wrap items-baseline gap-3">
        <span class="font-serif text-xl text-accent">{d.n}</span>
        <h2 class="text-2xl">{d.title}</h2>
        <span class="chip">{d.mins}</span>
      </div>
      <p class="mt-2 max-w-prose font-semibold">{d.q}</p>
      <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{d.evidence.map(e => <li>{e}</li>)}</ul>
      <p class="mt-3 max-w-prose text-sm text-ink-muted"><span class="font-semibold">Sets:</span> {d.sets}</p>
    </section>
  ))}

  <section class="mt-12">
    <div class="flex flex-wrap items-baseline gap-3">
      <span class="font-serif text-xl text-accent">5</span>
      <h2 class="text-2xl">Split the work</h2>
      <span class="chip">15 min</span>
    </div>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{split.map(s => <li>{s}</li>)}</ul>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl">Reference: threats from the secondary research</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <tbody>
          {threats.map(([n, h, e]) => (
            <tr class="border-b border-line align-top"><td class="py-2 pr-3 font-semibold">{n}</td><td class="py-2 pr-3 font-semibold">{h}</td><td class="py-2">{e}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-12 mb-4">
    <h2 class="text-2xl">FYI</h2>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{fyi.map(f => <li>{f}</li>)}</ul>
  </section>
</Base>
