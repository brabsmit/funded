---
// One unlisted sub-PRD per FCA workstream. Data lives in _workstreams.ts; noindex like the parent PRD.
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/url';
import { workstreams, type Workstream } from './_workstreams';

export function getStaticPaths() {
  return workstreams.map(w => ({ params: { ws: w.slug }, props: { w } }));
}
interface Props { w: Workstream }
const { w } = Astro.props;
const i = workstreams.findIndex(x => x.slug === w.slug);
const prev = workstreams[i - 1];
const next = workstreams[i + 1];
---
<Base title={`${w.n} ${w.name} (FCA)`} description={`Internal sub-PRD for FCA workstream ${w.n}.`} noindex>
  <aside class="mb-8 rounded-lg border-2 border-draft bg-draft-soft p-4 text-sm" role="note">
    <span class="stamp">Internal</span>
    <p class="mt-3 max-w-prose">Team document for our New Business Ventures Final Case Analysis. Not part of the FundED tool. Don’t forward it outside the team.</p>
  </aside>

  <p class="text-sm"><a href={href('/fca-readahead/')} class="underline">← FundED PRD (FCA)</a></p>
  <p class="mt-4 text-[0.7rem] uppercase tracking-wide text-ink-muted">Workstream sub-PRD · {w.n}</p>
  <h1 class="mt-1 text-4xl">{w.name}</h1>
  <dl class="mt-5 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[8rem_1fr]">
    <dt class="text-ink-muted">Owners</dt><dd>{w.staff}: <span class="text-warn">names TBD</span></dd>
    <dt class="text-ink-muted">Questions</dt><dd>{w.qs}</dd>
    <dt class="text-ink-muted">Feeds</dt><dd>{w.feeds}</dd>
  </dl>

  <section class="mt-8 rounded-lg border-2 border-accent bg-accent-soft p-5">
    <h2 class="text-2xl">Objective</h2>
    <p class="mt-2 max-w-prose">{w.objective}</p>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">1. Context</h2>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{w.context.map(c => <li>{c}</li>)}</ul>
  </section>

  <section class="mt-10 grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-2xl">2. In scope</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{w.inScope.map(c => <li>{c}</li>)}</ul>
    </div>
    <div>
      <h2 class="text-2xl">3. Out of scope</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{w.outScope.map(c => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">4. Who we contact</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[34rem] text-left text-sm">
        <thead class="border-b-2 border-line text-ink-muted"><tr><th class="py-2 pr-3">Who</th><th class="py-2 pr-3">Why</th><th class="py-2">How many</th></tr></thead>
        <tbody>{w.targets.map(t => (<tr class="border-b border-line align-top"><td class="py-2 pr-3 font-semibold">{t.who}</td><td class="py-2 pr-3">{t.why}</td><td class="py-2">{t.n}</td></tr>))}</tbody>
      </table>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">5. Interview guide</h2>
    <p class="mt-2 max-w-prose text-sm text-ink-muted">Ask open questions first; use probes only if the answer doesn’t cover them. Keep it under 20 minutes.</p>
    <ol class="mt-4 grid gap-3">
      {w.guide.map((g, k) => (
        <li class="rounded-lg border border-line bg-white p-4 text-sm">
          <p class="font-semibold">{k + 1}. {g.q}</p>
          {g.probes.length > 0 && <ul class="mt-2 list-disc space-y-1 pl-5 text-ink-muted">{g.probes.map(p => <li>{p}</li>)}</ul>}
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">6. Desk research</h2>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{w.desk.map(c => <li>{c}</li>)}</ul>
  </section>

  <section class="mt-10 rounded-lg border-2 border-dashed border-draft bg-white p-5">
    <h2 class="text-2xl">7. Threshold this workstream owns</h2>
    <dl class="mt-3 grid gap-x-4 gap-y-2 text-sm sm:grid-cols-[6rem_1fr]">
      <dt class="text-ink-muted">Owns</dt><dd>{w.threshold.owns}</dd>
      <dt class="text-ink-muted">Rule</dt><dd class="font-semibold">{w.threshold.rule}</dd>
      <dt class="text-ink-muted">Method</dt><dd>{w.threshold.method}</dd>
    </dl>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">8. Deliverables</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <thead class="border-b-2 border-line text-ink-muted"><tr><th class="py-2 pr-3">Deliverable</th><th class="py-2 pr-3">Due</th><th class="py-2">Done when</th></tr></thead>
        <tbody>{w.deliverables.map(d => (<tr class="border-b border-line align-top"><td class="py-2 pr-3 font-semibold">☐ {d.d}</td><td class="py-2 pr-3 whitespace-nowrap">{d.due}</td><td class="py-2">{d.accept}</td></tr>))}</tbody>
      </table>
    </div>
  </section>

  <section class="mt-10 grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-2xl">9. Depends on</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{w.upstream.map(c => <li>{c}</li>)}</ul>
    </div>
    <div>
      <h2 class="text-2xl">10. Hands off to</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{w.downstream.map(c => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">11. Day-by-day plan</h2>
    <ol class="mt-4 grid gap-2 text-sm">
      {w.plan.map(([d, t]) => (<li class="grid grid-cols-[6.5rem_1fr] gap-3 border-l-4 border-accent-mid pl-3"><span class="font-semibold">{d}</span><span>{t}</span></li>))}
    </ol>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">12. Risks and mitigations</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[34rem] text-left text-sm">
        <thead class="border-b-2 border-line text-ink-muted"><tr><th class="py-2 pr-3">Risk</th><th class="py-2">Mitigation</th></tr></thead>
        <tbody>{w.risks.map(x => (<tr class="border-b border-line align-top"><td class="py-2 pr-3">{x.r}</td><td class="py-2">{x.m}</td></tr>))}</tbody>
      </table>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">13. Course frameworks</h2>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{w.frameworks.map(c => <li>{c}</li>)}</ul>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl">14. Working rules</h2>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm">{w.rules.map(c => <li>{c}</li>)}</ul>
  </section>

  <nav class="mt-12 mb-4 flex flex-wrap justify-between gap-4 border-t border-line pt-4 text-sm">
    {prev ? <a href={href(`/fca-readahead/${prev.slug}/`)} class="underline">← {prev.n} {prev.name}</a> : <span />}
    {next && <a href={href(`/fca-readahead/${next.slug}/`)} class="underline">{next.n} {next.name} →</a>}
  </nav>
</Base>
